# Homebrew
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Completions
FPATH="$(brew --prefix)/share/zsh-completions:${FPATH}"
autoload -Uz compinit && compinit

# Plugins
source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
source "${ZDOTDIR:-~/.config/zsh}/.fzf-tab/fzf-tab.plugin.zsh"
source <(fzf --zsh)

# Tools
eval "$(starship init zsh)"
eval "$(atuin init zsh)"
eval "$(zoxide init zsh --cmd cd)"

# Worktrunk
if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init zsh)"
fi

# mise
eval "$(mise activate zsh)"

# direnv
emulate zsh -c "$(direnv hook zsh)"

# kubectl
if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion zsh)
fi
alias k=kubectl
compdef __start_kubectl k

# gcloud
_gcloud_sdk="$(brew --prefix)/Caskroom/gcloud-cli/latest/google-cloud-sdk"
[[ -f "${_gcloud_sdk}/path.zsh.inc" ]] && source "${_gcloud_sdk}/path.zsh.inc"
[[ -f "${_gcloud_sdk}/completion.zsh.inc" ]] && source "${_gcloud_sdk}/completion.zsh.inc"
unset _gcloud_sdk

# GPG
export GPG_TTY=$(tty)

# VS Code multi-project launcher
[[ -f "${ZDOTDIR:-~/.config/zsh}/.code-projects.zsh" ]] && source "${ZDOTDIR:-~/.config/zsh}/.code-projects.zsh"

# Docker Sandbox launcher
[[ -f "${ZDOTDIR:-~/.config/zsh}/.sbx-claude.zsh" ]] && source "${ZDOTDIR:-~/.config/zsh}/.sbx-claude.zsh"

# bun completions
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
