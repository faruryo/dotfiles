layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Monitoring" {
        pane split_direction="vertical" {
            pane {
                pane name="System" command="top"
                pane name="Logs"
            }
            pane {
                pane name="Claude" {
                    command "zsh"
                    args "-c" "TERM_PROGRAM=iTerm.app claude; exec zsh"
                }
                pane name="Terminal"
            }
        }
    }
}
