layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Dev" focus=true {
        pane split_direction="vertical" {
            pane size="20%" name="Explorer" command="yazi"
            pane size="55%" name="Editor" command="hx" focus=true
            pane size="25%" name="Claude" command="claude"
        }
    }

    swap_tiled_layout name="sidebar" {
        tab {
            pane split_direction="vertical" {
                pane size="20%" name="Explorer" command="yazi"
                pane size="55%" name="Editor" command="hx" focus=true
                pane size="25%" name="Claude" command="claude"
            }
        }
        tab {
            pane split_direction="vertical" {
                // Explorer is hidden
                pane size="70%" name="Editor" command="hx" focus=true
                pane size="30%" name="Claude" command="claude"
            }
        }
    }

    swap_floating_layout name="lazygit" {
        floating_panes {
            pane x="10%" y="10%" width="80%" height="80%" name="Lazygit" command="lazygit"
        }
    }
}
